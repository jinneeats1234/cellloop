# Variables read by docker-compose.yml (copy to .env in the project root).
# Application settings live in backend/.env (see backend/.env.example).

# Password for the local Postgres container (also used in the API's DATABASE_URL).
POSTGRES_PASSWORD=change-me

# Build the API image with BoTorch/PyTorch and impedance.py (larger image).
INSTALL_ML=0

# AWS credentials passed into the API container when LLM_PROVIDER=bedrock or STORAGE_BACKEND=s3.
# Prefer an IAM role / AWS SSO in real deployments.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
