# ─────────────────────────────────────────────────────────────────────────────
# CellLoop backend configuration
#
# Copy to backend/.env (./start.sh does this for you on first run) and adjust.
# Every value below is the built-in default unless noted, so an empty .env also
# works for local development. Real environment variables override this file.
# Invalid combinations stop the server at startup with a list of what to fix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=dev                         # dev | test | prod  (prod enforces Cognito, Postgres and S3)
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=["http://localhost:5173"]   # JSON list of browser origins allowed to call the API
FRONTEND_URL=http://localhost:5173  # where opening the API root in a browser redirects

# ── Database ─────────────────────────────────────────────────────────────────
# Local default: SQLite file in backend/ (no setup needed).
DATABASE_URL=sqlite:///./cellloop.db
# PostgreSQL + pgvector (docker compose, Amazon RDS):
# DATABASE_URL=postgresql+psycopg://cellloop:cellloop@localhost:5432/cellloop
EMBEDDING_DIM=1024                  # must match the embedding model (Titan v2: 256, 512 or 1024)

# ── Authentication ───────────────────────────────────────────────────────────
AUTH_MODE=dev                       # dev = pick a demo account | cognito = Amazon Cognito sign-in
# Signs dev tokens. At least 32 characters. ./start.sh replaces this with a random value.
DEV_JWT_SECRET=dev-only-secret-change-me-0123456789
# Required when AUTH_MODE=cognito:
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# ── File storage (raw partner uploads) ───────────────────────────────────────
STORAGE_BACKEND=local               # local | s3
LOCAL_STORAGE_DIR=./data/uploads    # relative to backend/
S3_BUCKET=                          # required when STORAGE_BACKEND=s3
S3_KMS_KEY_ID=                      # optional; defaults to the bucket's KMS key
MAX_UPLOAD_MB=25

# ── AI ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=mock                   # mock = offline stand-in | bedrock = Claude + Titan on Amazon Bedrock
AWS_REGION=us-east-1                # Bedrock and S3 region; AWS credentials come from the usual AWS chain
BEDROCK_CLAUDE_MODEL=anthropic.claude-opus-5-5
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_TIMEOUT_S=300                   # per-request timeout for Claude calls
LLM_MAX_RETRIES=2                   # automatic retries on throttling / transient errors
QA_TOP_K=6                          # passages retrieved per question
# QA_MIN_SIMILARITY=0.30            # evidence threshold; default 0.30 (bedrock) / 0.08 (mock)

# ── Program targets (dashboard and recommender) ──────────────────────────────
TARGET_ASR_OHM_CM2=0.30
TARGET_OPERATING_TEMP_C=650
BASELINE_CYCLES_TO_TARGET=40        # historical cycles-to-target; the 25% reduction is measured against this
TURNAROUND_TARGET_HOURS=48
