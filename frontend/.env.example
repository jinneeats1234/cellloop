# ─────────────────────────────────────────────────────────────────────────────
# CellLoop frontend configuration (copy to frontend/.env)
#
# All defaults work for local development, so this file is optional.
# VITE_* values are baked into the JavaScript bundle at build time and are
# visible to anyone using the app: never put secrets here.
# Auth mode, AI provider and program targets are read from the API at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# API origin. Leave empty to use the same origin (dev server proxy / nginx).
VITE_API_BASE=
# Default request timeout in milliseconds (AI-backed calls use a longer limit).
VITE_API_TIMEOUT_MS=30000

# Amazon Cognito Hosted UI (only needed when the API runs with AUTH_MODE=cognito)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# Dev server only: where `npm run web` proxies /api (./start.sh sets this automatically).
# VITE_API_PROXY=http://127.0.0.1:8000
